# bunnyfit environment — copy to .env and fill real values.
# NEVER commit the real .env (it is git-ignored). Placeholders only here (SDS §8).

# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/bunnyfit
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/bunnyfit_test

# Authentication
# Generate a real one: openssl rand -base64 48  (must be at least 32 bytes; the API refuses to start otherwise,
# so the placeholder below is intentionally too short to run with)
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_COST=10

# Business date — all "today" decisions use this timezone (Asia/Bangkok)
APP_TIMEZONE=Asia/Bangkok

# Seed accounts (private handoff or generated; never a real user password)
SEED_MANAGER_PASSWORD=change-me
SEED_PARTICIPANT_PASSWORD=change-me
